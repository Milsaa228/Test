{
  "expo": {
    "name": "Делёжка счёта",
    "slug": "split-bill",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.splitbill",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна, чтобы сфотографировать чек",
        "NSPhotoLibraryUsageDescription": "Доступ к фото нужен, чтобы выбрать снимок чека"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.splitbill"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Камера нужна, чтобы сфотографировать чек",
          "photosPermission": "Доступ к фото нужен, чтобы выбрать снимок чека"
        }
      ]
    ],
    "scheme": "splitbill"
  }
}
