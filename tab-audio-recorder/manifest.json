{
  "manifest_version": 3,
  "name": "Tab Audio Recorder",
  "version": "1.0.0",
  "description": "Записывает звук текущей вкладки в файл и сохраняет информацию о треке, который сейчас играет.",
  "permissions": ["tabCapture", "offscreen", "downloads", "storage", "scripting", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Tab Audio Recorder", "default_popup": "popup.html" },
  "minimum_chrome_version": "116"
}
