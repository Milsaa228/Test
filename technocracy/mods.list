# Список модов сборки Technocracy (Minecraft 1.20.1, Forge 47.x).
# Формат строки: <источник> <slug> [# комментарий]
#   источник: curseforge | modrinth
# Зависимости (библиотеки) packwiz подтягивает сам.
# Все slug проверены по CurseForge (октябрь 2026). Помечены «?» моды,
# для которых не нашлось явного подтверждения сборки Forge 1.20.1.

# ─── Ядро и интеграция ─────────────────────────────────────────────
curseforge jei                          # рецепты
curseforge just-enough-resources-jer    # где генерируются руды, что дропается
curseforge jade                         # подсказки при наведении
curseforge jade-addons                  # дополнительные данные в Jade
curseforge kubejs                       # скрипты сборки (кастомные рецепты)
curseforge kubejs-create                # рецепты Create из KubeJS
curseforge almostunified                # унификация руд/слитков разных модов
curseforge polymorph                    # выбор результата при конфликте рецептов
curseforge patchouli                    # книги-руководства

# ─── Эпоха пара: Create ────────────────────────────────────────────
curseforge create
curseforge create-steam-n-rails         # поезда, семафоры, широкая колея
curseforge createaddition               # Crafts & Additions: электричество FE <-> SU
curseforge create-new-age               # генераторы, реакторы для Create
curseforge create-diesel-generators     # дизельные двигатели
curseforge create-enchantment-industry  # автоматическое зачарование
curseforge create-big-cannons           # артиллерия
curseforge create-ore-excavation        # бурение рудных жил
curseforge create-mechanical-extruder   # генерация булыжника и руд экструдером
curseforge create-power-loader          # чанклоадеры для поездов и контрапций
curseforge slice-and-dice               # автоматическая готовка
curseforge create-stuff-additions       # ранцы, гаджеты
curseforge create-jetpack               # реактивный ранец на воздухе
curseforge create-encased               # валы и шестерни в корпусах
curseforge create-connected             # мелкие полезные блоки
